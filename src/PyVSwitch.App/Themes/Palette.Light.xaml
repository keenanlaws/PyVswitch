<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg.Window" Color="#F4F6FA" />
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#EBEEF4" />
    <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.CardHover" Color="#F6F8FC" />
    <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Subtle" Color="#F0F3F8" />
    <SolidColorBrush x:Key="Stroke" Color="#DCE1EA" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#C2CAD8" />

    <SolidColorBrush x:Key="Text" Color="#131722" />
    <SolidColorBrush x:Key="Text.Muted" Color="#556074" />
    <SolidColorBrush x:Key="Text.Faint" Color="#8791A3" />

    <SolidColorBrush x:Key="Accent" Color="#2F7DE1" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#2470D2" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#1D61B8" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#E3EDFC" />
    <SolidColorBrush x:Key="Accent.Text" Color="#1F66C4" />
    <SolidColorBrush x:Key="Accent.On" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brand.Yellow" Color="#A87B00" />
    <SolidColorBrush x:Key="Brand.Yellow.Soft" Color="#FFF3C4" />

    <SolidColorBrush x:Key="Success" Color="#1A8F5E" />
    <SolidColorBrush x:Key="Success.Soft" Color="#DDF5EA" />
    <SolidColorBrush x:Key="Warning" Color="#A66A10" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#FCEFD6" />
    <SolidColorBrush x:Key="Danger" Color="#CF3F50" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#FBE3E6" />
    <SolidColorBrush x:Key="Neutral.Soft" Color="#E9EDF4" />

    <SolidColorBrush x:Key="Overlay.Hover" Color="#0D10203A" />
    <SolidColorBrush x:Key="Overlay.Pressed" Color="#1A10203A" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#C2CAD8" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#9AA5B8" />
    <SolidColorBrush x:Key="Overlay" Color="#99F4F6FA" />
    <Color x:Key="Shadow.Color">#5A6B85</Color>

    <RadialGradientBrush x:Key="Glow.Blue" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#262F7DE1" Offset="0" />
        <GradientStop Color="#002F7DE1" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Glow.Yellow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#33FFD43B" Offset="0" />
        <GradientStop Color="#00FFD43B" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Hero.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E3EDFC" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="0.62" />
        <GradientStop Color="#FFF6D6" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
