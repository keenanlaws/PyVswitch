<UserControl x:Class="PyVSwitch.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PyVSwitch.App.Controls">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowHelp" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,3,24,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Stroke}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,0,28,14">
            <TextBlock Style="{StaticResource H1}" Text="Settings" />
            <TextBlock Style="{StaticResource Muted}" Text="How pyvswitch behaves on this PC." Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
            <StackPanel>
                <!-- Switching -->
                <TextBlock Style="{StaticResource Caption}" Text="SWITCHING" Margin="2,0,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="User"
                                                 IsChecked="{Binding PathScope, Converter={StaticResource IsEqual}, ConverterParameter=User}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="System"
                                                 IsChecked="{Binding PathScope, Converter={StaticResource IsEqual}, ConverterParameter=System}" />
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="PATH to edit" />
                                <TextBlock Style="{StaticResource RowHelp}" Text="User changes only your account and needs no administrator rights. System affects everyone and requires running pyvswitch as administrator." />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UpdateLauncherDefault}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Keep the py launcher in step" />
                                <TextBlock Style="{StaticResource RowHelp}" Text="When you switch, also make the same version the default for the py command." />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- App -->
                <TextBlock Style="{StaticResource Caption}" Text="APP" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Dark"
                                                 IsChecked="{Binding Theme, Converter={StaticResource IsEqual}, ConverterParameter=Dark}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Light"
                                                 IsChecked="{Binding Theme, Converter={StaticResource IsEqual}, ConverterParameter=Light}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="System"
                                                 IsChecked="{Binding Theme, Converter={StaticResource IsEqual}, ConverterParameter=System}" />
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Theme" />
                                <TextBlock Style="{StaticResource RowHelp}" Text="System follows the Windows app mode." />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows" />
                                <TextBlock Style="{StaticResource RowHelp}" Text="Open quietly in the system tray when you sign in." />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Keep running in the tray when closed" />
                                <TextBlock Style="{StaticResource RowHelp}" Text="Closing the window leaves the tray icon, so switching stays one click away." />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowNotifications}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Notifications" />
                                <TextBlock Style="{StaticResource RowHelp}" Text="Show a Windows notification when the default Python changes." />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- PATH history -->
                <TextBlock Style="{StaticResource Caption}" Text="PATH HISTORY" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="12,10" Text="No changes yet. Every switch saves the previous PATH here so it can be restored."
                                   Visibility="{Binding HasBackups, Converter={StaticResource VisibleWhen}, ConverterParameter=false}" />
                        <ItemsControl ItemsSource="{Binding Backups}" Focusable="False"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,6,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE81C;" Foreground="{DynamicResource Text.Faint}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Text.Faint}" FontSize="12" Margin="12,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Height="30" ui:Ui.Icon="&#xE7A7;" Content="Restore" ToolTip="Put the PATH back to how it was before this change"
                                                Command="{Binding Tag.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Maintenance -->
                <TextBlock Style="{StaticResource Caption}" Text="MAINTENANCE" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE71B;" Content="Create desktop shortcut" Margin="0,0,8,8" Command="{Binding DesktopShortcutCommand}" />
                            <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE8B7;" Content="Open log folder" Margin="0,0,8,8" Command="{Binding OpenLogsCommand}" />
                            <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE74D;" Content="Delete app data" Margin="0,0,8,8" Command="{Binding ResetAppDataCommand}" />
                            <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE713;" Content="Uninstall pyvswitch…" Margin="0,0,8,8" Command="{Binding OpenAppsSettingsCommand}"
                                    ToolTip="Opens Windows Settings, where pyvswitch can be removed" />
                        </WrapPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,8,0,14" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="github.com/keenanlaws/PyVswitch" Command="{Binding OpenRepoCommand}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/pyvswitch-logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="pyvswitch" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource Text.Muted}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="by ecuunlock.com  ·  MIT License" Foreground="{DynamicResource Text.Faint}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
