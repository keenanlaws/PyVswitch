<UserControl x:Class="PyVSwitch.App.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PyVSwitch.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,0,28,14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Versions" />
                <TextBlock Style="{StaticResource Muted}" Text="Every Python on this PC. Pick the one that answers to python." Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE72C;" Content="Rescan" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE896;" Content="Get Python" Margin="8,0,0,0"
                        Command="{Binding NavigateCommand}" CommandParameter="download" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Installs}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Style="{StaticResource Card.Row}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="IconTile" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource Neutral.Soft}">
                                        <Image Source="/Assets/pyvswitch-logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" />
                                            <ui:Pill Content="{Binding Architecture}" Margin="10,0,0,0" />
                                            <ui:Pill Content="Default" Tone="success" Margin="6,0,0,0"
                                                     Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Path}" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn.Primary}" Content="Set as default"
                                                Command="{Binding Tag.SwitchCommand, ElementName=Row}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=false}" />
                                        <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE7B8;" Content="Packages" Margin="8,0,0,0"
                                                Command="{Binding Tag.OpenPackagesCommand, ElementName=Row}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE756;" Margin="4,0,0,0" ToolTip="Open a terminal that uses this version"
                                                Command="{Binding Tag.OpenTerminalCommand, ElementName=Row}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE712;" ui:Ui.MenuOnClick="True" ToolTip="More"
                                                Tag="{Binding Tag, ElementName=Row}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Create virtual environment…" ui:Ui.Icon="&#xE710;"
                                                              Command="{Binding PlacementTarget.Tag.CreateVenvCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Open install folder" ui:Ui.Icon="&#xE8B7;"
                                                              Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Copy path to python.exe" ui:Ui.Icon="&#xE8C8;"
                                                              Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Uninstall…" ui:Ui.Icon="&#xE74D;" Tag="danger"
                                                              Command="{Binding PlacementTarget.Tag.UninstallPythonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Success}" />
                                    <Setter TargetName="IconTile" Property="Background" Value="{DynamicResource Success.Soft}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Padding="28" Visibility="{Binding HasInstalls, Converter={StaticResource VisibleWhen}, ConverterParameter=false}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource H2}" Text="No Python found yet" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" Text="Install any version straight from python.org." HorizontalAlignment="Center" Margin="0,6,0,14" />
                        <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE896;" Content="Get Python" HorizontalAlignment="Center"
                                Command="{Binding NavigateCommand}" CommandParameter="download" />
                    </StackPanel>
                </Border>

                <!-- Virtual environments -->
                <StackPanel Visibility="{Binding HasVenvs, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource H2}" Text="Virtual environments" Margin="0,18,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Text="Environments created with pyvswitch. They keep their own packages, separate from the base version." Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Venvs}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Style="{StaticResource Card.Row}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource Brand.Yellow.Soft}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE7B8;" Foreground="{DynamicResource Brand.Yellow}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" />
                                                <ui:Pill Content="venv" Tone="brand" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Mono}" Text="{Binding Folder}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE7B8;" Content="Packages"
                                                    Command="{Binding Tag.OpenPackagesCommand, ElementName=Row}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE756;" Margin="4,0,0,0" ToolTip="Open a terminal in this environment"
                                                    Command="{Binding Tag.OpenTerminalCommand, ElementName=Row}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE8B7;" ToolTip="Open folder"
                                                    Command="{Binding Tag.OpenFolderCommand, ElementName=Row}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE711;" ToolTip="Remove from this list (keeps the folder)"
                                                    Command="{Binding Tag.ForgetVenvCommand, ElementName=Row}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
