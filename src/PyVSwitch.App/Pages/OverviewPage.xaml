<UserControl x:Class="PyVSwitch.App.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PyVSwitch.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <Style x:Key="QuickCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Width" Value="196" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{DynamicResource Bg.Card}"
                                BorderBrush="{DynamicResource Stroke}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                    <TextBlock x:Name="Sub" Text="{Binding Architecture}" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border x:Name="Check"
                                        Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="{DynamicResource Success}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE73E;" Foreground="{DynamicResource Bg.Card}" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="Arrow"
                                           Style="{StaticResource Icon}"
                                           FontSize="12"
                                           Text="&#xE76C;"
                                           Foreground="{DynamicResource Text.Faint}"
                                           HorizontalAlignment="Right"
                                           Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.CardHover}" />
                                <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Success}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Success.Soft}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,0,28,14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Overview" />
                <TextBlock Style="{StaticResource Muted}" Text="Your Python setup at a glance." Margin="0,3,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE72C;" Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" ToolTip="Rescan this PC for Python (F5)" />
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
            <StackPanel>
                <!-- Hero -->
                <Border CornerRadius="16"
                        Background="{DynamicResource Hero.Background}"
                        BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1"
                        Padding="26,22,26,24"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="/Assets/pyvswitch-logo.png"
                               Width="190"
                               Opacity="0.16"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,-30,-34,-36"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center"
                                         Visibility="{Binding HasActive, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Style="{StaticResource Caption}" Text="ACTIVE INTERPRETER" Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding ActiveTitle}" FontFamily="{StaticResource Font.Display}" FontSize="34" FontWeight="SemiBold" />
                                <ui:Pill Content="{Binding ActiveArchitecture}" Tone="accent" Margin="14,8,0,0" FontSize="12"
                                         Visibility="{Binding HasActive, Converter={StaticResource VisibleWhen}}" />
                                <ui:Pill Content="{Binding ActiveScopeText}" Margin="6,8,0,0" FontSize="12"
                                         Visibility="{Binding HasActive, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>

                            <Border Style="{StaticResource Well}" Margin="0,14,0,0" HorizontalAlignment="Left" Padding="12,4,4,4" MaxWidth="640">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Mono}" Text="{Binding ActivePath}" VerticalAlignment="Center" MaxWidth="560" />
                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="8,0,0,0" ui:Ui.Icon="&#xE8C8;"
                                            Command="{Binding CopyPathCommand}" ToolTip="Copy path"
                                            Visibility="{Binding HasActive, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE8AB;" Content="Switch version"
                                        Command="{Binding NavigateCommand}" CommandParameter="versions" />
                                <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE7B8;" Content="Manage packages" Margin="8,0,0,0"
                                        Command="{Binding OpenPackagesCommand}" IsEnabled="{Binding HasActive}" />
                                <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE756;" Content="Open terminal" Margin="8,0,0,0"
                                        Command="{Binding OpenTerminalCommand}" IsEnabled="{Binding HasActive}" />
                                <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE896;" Content="Get another version" Margin="8,0,0,0"
                                        Command="{Binding NavigateCommand}" CommandParameter="download" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- System PATH shadow warning -->
                <Border Background="{DynamicResource Warning.Soft}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0"
                        Visibility="{Binding IsShadowed, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warning}" />
                        <TextBlock Grid.Column="1" Text="{Binding ShadowMessage}" TextWrapping="Wrap" Margin="12,0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Content="Open Doctor" Command="{Binding NavigateCommand}" CommandParameter="doctor" />
                    </Grid>
                </Border>

                <!-- Stat tiles -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Tile}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Accent.Soft}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{DynamicResource Accent.Text}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding InstallCountText}" FontFamily="{StaticResource Font.Display}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding InstallCountCaption}" FontSize="12.5" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Tile}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Brand.Yellow.Soft}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Foreground="{DynamicResource Brand.Yellow}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding ActivePackageCount}" FontFamily="{StaticResource Font.Display}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" Text="Packages in the default version" FontSize="12.5" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Tile}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Success.Soft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthTone}" Value="warning">
                                                <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthTone}" Value="neutral">
                                                <Setter Property="Background" Value="{DynamicResource Neutral.Soft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE9D9;">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HealthTone}" Value="warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HealthTone}" Value="neutral">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding HealthTitle}" FontFamily="{StaticResource Font.Display}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding HealthCaption}" FontSize="12.5" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Quick switch -->
                <TextBlock Style="{StaticResource H2}" Text="Quick switch" Margin="0,24,0,4" />
                <TextBlock Style="{StaticResource Muted}" Text="Click a version to make it the default python for new terminals." Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Installs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource QuickCard}"
                                    Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Card}" Visibility="{Binding HasInstalls, Converter={StaticResource VisibleWhen}, ConverterParameter=false}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Muted}" Text="No Python found on this PC yet." VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Primary}" Content="Get Python" Margin="14,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="download" />
                    </StackPanel>
                </Border>

                <!-- Recent changes -->
                <Grid Margin="0,16,0,10" Visibility="{Binding HasBackups, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource H2}" Text="Recent changes" />
                    <Button Style="{StaticResource Btn.Link}" Content="Undo last change" HorizontalAlignment="Right" Command="{Binding UndoLastSwitchCommand}" />
                </Grid>
                <Border Style="{StaticResource Card}" Padding="6" Visibility="{Binding HasBackups, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl ItemsSource="{Binding RecentBackups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE81C;" Foreground="{DynamicResource Text.Faint}" />
                                        <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" HorizontalAlignment="Right" Foreground="{DynamicResource Text.Faint}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
