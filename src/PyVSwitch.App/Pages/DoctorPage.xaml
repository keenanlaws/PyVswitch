<UserControl x:Class="PyVSwitch.App.Pages.DoctorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PyVSwitch.App.Controls">
    <UserControl.Resources>
        <!-- A round status badge whose colors follow a Tone string in the DataContext. -->
        <Style x:Key="ToneBadge" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource Success.Soft}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="accent">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning">
                    <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="danger">
                    <Setter Property="Background" Value="{DynamicResource Danger.Soft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="accent">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="danger">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,0,28,14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Doctor" />
                <TextBlock Style="{StaticResource Muted}" Text="Finds the usual reasons python runs the wrong version, and fixes what it safely can." Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" ui:Ui.Icon="&#xE72C;" Content="Check again" Command="{Binding RunDoctorCommand}" />
                <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE90F;" Content="Fix automatically" Margin="8,0,0,0" Command="{Binding FixPathCommand}"
                        Visibility="{Binding CanAutoFix, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
            <StackPanel>
                <!-- Summary -->
                <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Padding="20,18" Background="{DynamicResource Hero.Background}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="23" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Success.Soft}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthTone}" Value="warning">
                                            <Setter Property="Background" Value="{DynamicResource Warning.Soft}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthTone}" Value="neutral">
                                            <Setter Property="Background" Value="{DynamicResource Neutral.Soft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="FontSize" Value="20" />
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthTone}" Value="warning">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthTone}" Value="neutral">
                                                <Setter Property="Text" Value="&#xE9D9;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DoctorHeadline}" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding DoctorSubline}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsDoctorRunning, Converter={StaticResource VisibleWhen}}" />

                <!-- Findings -->
                <ItemsControl ItemsSource="{Binding Findings}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Style="{StaticResource Card.Row}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ToneBadge}">
                                        <TextBlock Style="{StaticResource ToneGlyph}" Text="{Binding Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}, ConverterParameter=notempty}" />
                                        <Border Style="{StaticResource Well}" Margin="0,10,0,0" Padding="12,3,3,3" HorizontalAlignment="Left"
                                                Visibility="{Binding HasFix, Converter={StaticResource VisibleWhen}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fix" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Fix}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
                                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="8,0,0,0" ui:Ui.Icon="&#xE8C8;" ToolTip="Copy"
                                                        Command="{Binding Tag.CopyCommand, ElementName=Row}" CommandParameter="{Binding Fix}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- PATH order -->
                <TextBlock Style="{StaticResource H2}" Text="How Windows finds python" Margin="0,18,0,4" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                           Text="Windows searches these folders from top to bottom, System entries before User entries. The first folder that contains python.exe wins." />
                <Border Style="{StaticResource Card}" Padding="6">
                    <ItemsControl ItemsSource="{Binding PathEntries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="7" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Order}" Foreground="{DynamicResource Text.Faint}" FontSize="11.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Scope}" Foreground="{DynamicResource Text.Faint}" FontSize="11.5" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PathText" Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding Path}" Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center" />
                                        <ui:Pill Grid.Column="3" Content="{Binding Badge}" Tone="{Binding Tone}" Margin="10,0,0,0"
                                                 Visibility="{Binding HasBadge, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="PathText" Property="Foreground" Value="{DynamicResource Text}" />
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bg.Subtle}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
