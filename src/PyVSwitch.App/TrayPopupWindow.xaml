<Window x:Class="PyVSwitch.App.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PyVSwitch.App.Controls"
        Width="348"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="VersionRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="9" Padding="10,9" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Stroke.Strong}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                <ui:Pill x:Name="Arch" Grid.Column="2" Content="{Binding Architecture}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Overlay.Hover}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Success.Soft}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Success}" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Arch" Property="Tone" Value="success" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PopupRoot"
            Margin="14,8,14,18"
            Opacity="0"
            CornerRadius="14"
            Background="{DynamicResource Bg.Elevated}"
            BorderBrush="{DynamicResource Stroke.Strong}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TranslateTransform Y="8" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource Shadow.Color}" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" />
        </Border.Effect>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PopupRoot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                        <DoubleAnimation Storyboard.TargetName="PopupRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         To="0"
                                         Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" Margin="6,4,6,10">
                <Image Source="/Assets/pyvswitch-logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="pyvswitch" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Pick the default python" FontSize="11.5" Foreground="{DynamicResource Text.Muted}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,6" />

            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Installs}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource VersionRow}" Click="Version_Click" Tag="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No Python found yet." Foreground="{DynamicResource Text.Muted}" Margin="10,12"
                               Visibility="{Binding HasInstalls, Converter={StaticResource VisibleWhen}, ConverterParameter=false}" />
                </StackPanel>
            </ScrollViewer>

            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,6,0,8" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn}" Content="Open app" ui:Ui.Icon="&#xE80F;" Click="Open_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Get Python" ui:Ui.Icon="&#xE896;" Click="Download_Click" Margin="4,0" HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE7E8;" Click="Exit_Click" Margin="4,0,0,0" ToolTip="Exit pyvswitch" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
