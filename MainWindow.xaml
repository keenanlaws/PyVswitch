<Window x:Class="PythonVersionSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PythonVersionSwitch.Controls"
        xmlns:models="clr-namespace:PythonVersionSwitch.Models"
        mc:Ignorable="d"
        Title="Python Version Switch"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/pyvswitch.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ShellPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.25" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#10151E" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="#141B26" />
            <Setter Property="BorderBrush" Value="#314B6A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#192435" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ButtonChrome" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
            <Setter Property="Foreground" Value="#F6FAFF" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
        </Style>

        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource ActionButtonStyle}" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF7F7" />
            <Setter Property="Background" Value="#3B2028" />
            <Setter Property="BorderBrush" Value="#88404A" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="#0D1118" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#172840" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#15243A" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="#0D1118" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter x:Name="ContentSite"
                                                                  IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  Margin="12,0,34,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" />
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Width="8"
                                                      Height="4"
                                                      Fill="{DynamicResource AccentAltBrush}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,14,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#0D1118"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    Background="#0D1118"
                                    BorderBrush="#445A75"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Visibility="Collapsed"
                                      Stroke="{DynamicResource AccentAltBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 4 9 L 8 13 L 14 5" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="#111923"
                                BorderBrush="#2F405A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,8,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#14263A" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,18,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="#111923"
                                BorderBrush="#30435E"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#162437" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#152A3E" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type models:PythonInstall}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>

                <controls:PythonMark Width="48" Height="48" />

                <StackPanel Grid.Column="1" Margin="6,0,14,0">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="#26384F"
                            BorderBrush="#3E526D"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="9,5">
                        <TextBlock Text="{Binding Architecture}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding VersionLabel}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:InstallablePythonPackage}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <controls:PythonMark Width="40" Height="40" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding Source}"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:PathBackup}">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Opacity="0.32">
            <Ellipse Width="520" Height="520" Fill="#101D2B" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-220,0,0" />
            <Ellipse Width="460" Height="460" Fill="#1B1E24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-130,-160" />
        </Grid>

        <Grid x:Name="Root"
              Margin="28"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="14" />
            </Grid.RenderTransform>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.28" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0"
                                             Duration="0:0:0.36">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ShellPanelStyle}" Padding="22" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:PythonMark Width="60" Height="60" />

                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Python Version Switch"
                                   FontSize="30"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding ActiveDetail}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Image Grid.Column="1"
                           Source="/Assets/python-shield.png"
                           Width="92"
                           Opacity="0.1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ProgressBar Width="90"
                                     Height="8"
                                     Margin="0,0,12,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Content="Refresh"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="RefreshButton_Click"
                                Margin="0,0,8,0" />
                        <Button Content="About"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="AboutButton_Click"
                                Margin="0,0,8,0" />
                        <Button Content="Hide"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="HideButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ShellPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Active Interpreter"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ActiveTitle}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                            <Border Background="#112235"
                                    BorderBrush="#30445F"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,16,0,0">
                                <TextBlock Text="{Binding ActivePath}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Switch"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SwitchButton_Click"
                                        Margin="0,0,8,0" />
                                <Button Content="Rollback"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="RollbackButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource ShellPanelStyle}"
                            Margin="0,18,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Tool Settings"
                                           FontSize="18"
                                           FontWeight="Bold" />

                                <TextBlock Text="PATH scope"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,18,0,6" />
                                <ComboBox x:Name="ScopeCombo"
                                          SelectionChanged="ScopeCombo_SelectionChanged" />

                                <CheckBox x:Name="StartupCheck"
                                          Content="Start with Windows"
                                          Checked="StartupCheck_Changed"
                                          Unchecked="StartupCheck_Changed"
                                          Margin="0,18,0,0" />
                                <CheckBox x:Name="MinimizeCheck"
                                          Content="Close to tray"
                                          Checked="SettingsCheck_Changed"
                                          Unchecked="SettingsCheck_Changed" />
                                <CheckBox x:Name="NotificationsCheck"
                                          Content="Tray notifications"
                                          Checked="SettingsCheck_Changed"
                                          Unchecked="SettingsCheck_Changed" />
                                <CheckBox x:Name="LauncherCheck"
                                          Content="Update py launcher default"
                                          Checked="SettingsCheck_Changed"
                                          Unchecked="SettingsCheck_Changed" />

                                <Button Content="Create desktop shortcut"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="DesktopShortcutButton_Click"
                                        Margin="0,20,0,0" />

                                <TextBlock Text="Backups"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,26,0,8" />
                                <ListBox x:Name="BackupList"
                                         ItemsSource="{Binding PathBackups}"
                                         MinHeight="100"
                                         MaxHeight="190" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource ShellPanelStyle}">
                    <TabControl>
                        <TabItem Header="Switch">
                            <Grid Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,16" LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Detected Python Versions"
                                                   FontSize="22"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding VersionCountText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Open downloads"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Width="168"
                                            Click="DownloadsButton_Click" />
                                </DockPanel>

                                <ListBox x:Name="PythonList"
                                         Grid.Row="1"
                                         Padding="0,0,0,0"
                                         ItemsSource="{Binding PythonInstalls}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Install">
                            <Grid Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Install More Python Versions"
                                               FontSize="22"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Search winget or open the official Windows downloads page."
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="List winget versions"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ListInstallableButton_Click"
                                                Margin="0,0,8,0" />
                                        <Button Content="Open Python.org"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Click="DownloadsButton_Click" />
                                    </StackPanel>
                                </StackPanel>

                                <ListBox x:Name="InstallableList"
                                         Grid.Row="1"
                                         ItemsSource="{Binding InstallableVersions}"
                                         Margin="0,18,0,0" />

                                <Button Grid.Row="2"
                                        Content="Install selected"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="InstallSelectedButton_Click"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Health">
                            <Grid Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run health check"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="HealthButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button Content="Open downloads"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="DownloadsButton_Click" />
                                </StackPanel>
                                <Border Grid.Row="1"
                                        Background="#0E1521"
                                        BorderBrush="#2D405B"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="0,18,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding HealthText}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Uninstall">
                            <Grid Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Uninstall And Cleanup"
                                               FontSize="22"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Remove startup entries, desktop shortcut, saved settings, and optionally this app folder."
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,18" />
                                </StackPanel>

                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                                    <Button Content="Remove shortcuts"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="RemoveShortcutButton_Click"
                                            Margin="0,0,8,0" />
                                    <Button Content="Delete app data"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="ResetAppDataButton_Click"
                                            Margin="4,0,4,0" />
                                    <Button Content="Run uninstaller"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="UninstallButton_Click"
                                            Margin="8,0,0,0" />
                                </UniformGrid>

                                <Border Grid.Row="2" Style="{StaticResource FlatPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="What the uninstaller does"
                                                   FontSize="16"
                                                   FontWeight="Bold" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Text="It disables startup launch, removes the desktop shortcut, deletes saved settings and backups, closes the app, then attempts to remove the current app folder. It does not remove Python installations or edit PATH." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#111A28"
                    BorderBrush="#30435E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="13,10"
                    Margin="0,18,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
