<Window x:Class="PythonVersionSwitch.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About pyvswitch"
        Width="430"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/pyvswitch.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border Margin="18"
            Padding="22"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            Background="{DynamicResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/pyvswitch-logo.png"
                       Width="68"
                       Height="68"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="pyvswitch"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="by ecuunlock.com"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentAltBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,14,0,0" />
                    <TextBlock Text="Python PATH switcher for Windows"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <Button Grid.Row="1"
                    Content="Close"
                    Width="112"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Background" Value="#141B26" />
                        <Setter Property="BorderBrush" Value="#314B6A" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="16,10" />
                        <Setter Property="MinHeight" Value="42" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                                            <Setter TargetName="ButtonChrome" Property="Background" Value="#192435" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
