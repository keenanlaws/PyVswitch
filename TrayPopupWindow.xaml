<Window x:Class="PythonVersionSwitch.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PythonVersionSwitch.Controls"
        xmlns:models="clr-namespace:PythonVersionSwitch.Models"
        Width="430"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PopupActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F6FAFF" />
            <Setter Property="Background" Value="#141B26" />
            <Setter Property="BorderBrush" Value="#314B6A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#192435" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#FFD43B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ButtonChrome" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type models:TrayPythonOption}">
            <Button Tag="{Binding Install}"
                    Click="VersionButton_Click"
                    Cursor="Hand"
                    BorderThickness="0"
                    Padding="0"
                    Background="Transparent"
                    Margin="0,0,0,10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="#111923"
                                BorderBrush="#30435E"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>

                                <controls:PythonMark Width="42" Height="42" />

                                <StackPanel Grid.Column="1" Margin="2,0,10,0">
                                    <TextBlock Text="{Binding Install.DisplayName}"
                                               Foreground="#F6FAFF"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Install.ExecutablePath}"
                                               Foreground="#95A6BA"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <Border x:Name="StatusPill"
                                            Background="#14263A"
                                            BorderBrush="#42546E"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="7,4">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="#FFD43B"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding AccentText}"
                                               Foreground="#BFCADC"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#162437" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#3776AB" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#152A3E" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FFD43B" />
                                <Setter TargetName="StatusPill" Property="Background" Value="#1E2A19" />
                                <Setter TargetName="StatusPill" Property="BorderBrush" Value="#FFD43B" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="PopupRoot"
            Opacity="0"
            CornerRadius="18"
            BorderBrush="#42546E"
            BorderThickness="1"
            Padding="1">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#182033" Offset="0" />
                <GradientStop Color="#07090D" Offset="0.55" />
                <GradientStop Color="#171B22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PopupRoot"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1"
                                         Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetName="PopupRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1"
                                         Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="PopupRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1"
                                         Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:PythonMark Width="46" Height="46" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Python Switcher"
                               Foreground="#F6FAFF"
                               FontSize="19"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding HeaderDetail}"
                               Foreground="#95A6BA"
                               FontSize="12"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,12"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Options}" />
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Open"
                        Style="{StaticResource PopupActionButtonStyle}"
                        Click="OpenMainButton_Click" />
                <Button Grid.Column="2"
                        Content="Refresh"
                        Style="{StaticResource PopupActionButtonStyle}"
                        Click="RefreshButton_Click" />
                <Button Grid.Column="4"
                        Content="Exit"
                        Style="{StaticResource PopupActionButtonStyle}"
                        Click="ExitButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
